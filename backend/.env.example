# ==============================================================================
# BPS FRESH MILLS — PRODUCTION ENVIRONMENT CONFIGURATION
# Tagline: "Freshly Milled. Naturally Good."
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Security & Authentication (Generate using: openssl rand -base64 48)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
ADMIN_EMAIL=bpsfreshmills@gmail.com
ADMIN_INITIAL_PASSWORD=replace_with_strong_superadmin_password

# Production URLs & Routing
# Customer Portal: https://bpsfreshmills.in
# Admin Portal:    https://bpsfreshmills.in/admin
# Delivery Portal: https://bpsfreshmills.in/delivery
FRONTEND_URL=https://bpsfreshmills.in
CORS_ORIGIN=https://bpsfreshmills.in,https://www.bpsfreshmills.in

# Payment Configuration (COD ONLY)
PAYMENT_METHOD=Cash on Delivery (COD ONLY)

# Delivery Radius Configuration (Varanasi Mill Coordinates)
SHOP_LAT=25.4678
SHOP_LON=83.0564
MAX_DELIVERY_RADIUS_KM=15

# AI Business Assistant (Server-Side Only)
# Optional: Provide Google Gemini API Key for augmented reasoning.
# The built-in deterministic engine provides 100% zero-hallucination answers even if blank.
GEMINI_API_KEY=

# Storage Provider (Default: 'local' uploads/ folder; Supports 's3' or 'cloudinary')
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=

# Database & Automated Backups
DATA_DIR=./data
BACKUP_DIR=./backups

# WhatsApp Cloud API (Meta for Developers - Production Order Alerts)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# SMTP Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bpsfreshmills@gmail.com
SMTP_PASS=your_gmail_app_specific_password_here
EMAIL_FROM="BPS Fresh Mills" <bpsfreshmills@gmail.com>
