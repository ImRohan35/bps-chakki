# Copy this file to .env and fill in your actual values
PORT=5000
JWT_SECRET=your_secret_jwt_key_here
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_INITIAL_PASSWORD=your_strong_password_here

# Frontend Application Base URL (used for Track Your Order links)
FRONTEND_URL=http://localhost:5173

# WhatsApp Business / WhatsApp Cloud API credentials
# Set up via Meta for Developers (developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# Email (SMTP) credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BPS Team" <orders@bpsfreshmills.com>

